{
  "name": "Local Python Pipeline Automation",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/trigger",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "{\n  \"script\": \"run_pipeline.py\",\n  \"force\": false\n}"
      },
      "id": "trigger-pipeline",
      "name": "Trigger Python Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/health",
        "method": "GET",
        "options": {}
      },
      "id": "check-health",
      "name": "Check Trigger Server Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "health-check-if",
      "name": "Server Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [750, 100]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "wait-10s",
      "name": "Wait 10s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/health",
        "method": "GET",
        "options": {}
      },
      "id": "poll-completion",
      "name": "Poll Pipeline Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.running }}",
              "operation": "equal",
              "value2": false
            }
          ]
        }
      },
      "id": "pipeline-done-if",
      "name": "Pipeline Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "functionCode": "const fs = require('fs');\nconst path = require('path');\n\nconst outputDir = '/data/scraper/output';\nconst expectedFiles = [\n  'mindler_career_library.json',\n  'swayam_courses.json',\n  'swayam_courses_enriched.json'\n];\n\nconst results = {};\nlet allExist = true;\n\nfor (const file of expectedFiles) {\n  const filePath = path.join(outputDir, file);\n  const exists = fs.existsSync(filePath);\n  let size = 0;\n  let validJson = false;\n  \n  if (exists) {\n    const stats = fs.statSync(filePath);\n    size = stats.size;\n    try {\n      const content = fs.readFileSync(filePath, 'utf8');\n      JSON.parse(content);\n      validJson = true;\n    } catch (e) {\n      validJson = false;\n    }\n  }\n  \n  results[file] = {\n    exists,\n    size,\n    validJson,\n    path: filePath\n  };\n  \n  if (!exists || !validJson) {\n    allExist = false;\n  }\n}\n\nreturn [{\n  json: {\n    allFilesValid: allExist,\n    files: results,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "verify-outputs",
      "name": "Verify Output Files",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.allFilesValid }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "id": "validation-if",
      "name": "All Outputs Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1750, 200]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'SUCCESS',\n    message: 'Pipeline completed successfully. All output files created and valid.',\n    files: $json.files,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "success-node",
      "name": "Workflow Success",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2000, 100]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'FAILURE',\n    message: 'Pipeline failed: Some output files missing or invalid.',\n    files: $json.files,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "failure-node",
      "name": "Workflow Failure",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'ERROR',\n    message: 'Trigger server not healthy. Is trigger_server.py running on Windows host?',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "server-error",
      "name": "Server Unhealthy",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 100]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'ERROR',\n    message: 'Pipeline trigger failed. Check trigger server logs.',\n    response: $json,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "trigger-error",
      "name": "Trigger Failed",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 450]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Check Trigger Server Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Trigger Server Health": {
      "main": [
        [
          {
            "node": "Server Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Server Healthy?": {
      "main": [
        [
          {
            "node": "Trigger Python Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Server Unhealthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Python Pipeline": {
      "main": [
        [
          {
            "node": "Wait 10s",
