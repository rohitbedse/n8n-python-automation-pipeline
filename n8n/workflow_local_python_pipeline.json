            "index": 0
          }
        ],
        [
          {
            "node": "Wait 10s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Output Files": {
      "main": [
        [
          {
            "node": "All Outputs Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All Outputs Valid?": {
      "main": [
        [
          {
            "node": "Workflow Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Workflow Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "1"
}