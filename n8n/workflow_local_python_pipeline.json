{
  "name": "Daily Career Data Pipeline",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 2,
              "minute": 0
            }
          ]
        },
        "timezone": "Asia/Kolkata"
      },
      "id": "schedule-trigger",
      "name": "Daily Schedule (2 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/health",
        "method": "GET",
        "options": {
          "headers": {
            "X-API-Key": "={{ $env.SCRAPER_TRIGGER_API_KEY || '' }}"
          }
        }
      },
      "id": "check-health",
      "name": "Check Trigger Server Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "health-check-if",
      "name": "Server Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [750, 100]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/trigger",
        "method": "POST",
        "jsonParameters": true,
        "options": {
          "headers": {
            "X-API-Key": "={{ $env.SCRAPER_TRIGGER_API_KEY || '' }}"
          }
        },
        "bodyParametersJson": "{\n  \"script\": \"run_pipeline_new.py\",\n  \"force\": false\n}"
      },
      "id": "trigger-pipeline",
      "name": "Trigger Python Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "wait-10s",
      "name": "Wait 10s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/health",
        "method": "GET",
        "options": {
          "headers": {
            "X-API-Key": "={{ $env.SCRAPER_TRIGGER_API_KEY || '' }}"
          }
        }
      },
      "id": "poll-completion",
      "name": "Poll Pipeline Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.running }}",
              "operation": "equal",
              "value2": false
            }
          ]
        }
      },
      "id": "pipeline-done-if",
      "name": "Pipeline Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'SUCCESS',\n    message: 'Pipeline completed successfully.',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "success-node",
      "name": "Workflow Success",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1750, 100]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'ERROR',\n    message: 'Trigger server not healthy. Is trigger_server.py running on Windows host?',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "server-error",
      "name": "Server Unhealthy",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 100]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'ERROR',\n    message: 'Pipeline trigger failed. Check trigger server logs.',\n    response: $json,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "trigger-error",
      "name": "Trigger Failed",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 450]
    }
  ],
  "connections": {
    "Daily Schedule (2 AM)": {
      "main": [
        [
          {
            "node": "Check Trigger Server Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Trigger Server Health": {
      "main": [
        [
          {
            "node": "Server Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Server Healthy?": {
      "main": [
        [
          {
            "node": "Trigger Python Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Server Unhealthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Python Pipeline": {
      "main": [
        [
          {
            "node": "Wait 10s",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Trigger Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10s": {
      "main": [
        [
          {
            "node": "Poll Pipeline Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Pipeline Completion": {
      "main": [
        [
          {
            "node": "Pipeline Done?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pipeline Done?": {
      "main": [
        [
          {
            "node": "Workflow Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 10s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "1"
}